#!/usr/bin/env node

var app = require('../app');
var debug = require('debug')('quickcombackend:server');
var http = require('http');

var desiredPort = normalizePort(process.env.PORT || '5000');
var currentPort = desiredPort;

app.set('port', currentPort);

var server;

function startServer(portToUse) {
  server = http.createServer(app);
  server.on('error', onError);
  server.on('listening', onListening);
  server.listen(portToUse, '0.0.0.0');
}

startServer(currentPort);

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    return val;
  }

  if (port >= 0) {
    return port;
  }

  return false;
}

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind =
    typeof currentPort === 'string'
      ? 'Pipe ' + currentPort
      : 'Port ' + currentPort;

  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;

    case 'EADDRINUSE': {
      var nextPort = Number(currentPort) + 1;
      currentPort = nextPort;
      app.set('port', currentPort);
      console.warn(bind + ' is already in use. Trying port ' + currentPort + '...');
      startServer(currentPort);
      break;
    }

    default:
      throw error;
  }
}

function onListening() {
  var addr = server.address();

  var bind =
    typeof addr === 'string'
      ? 'pipe ' + addr
      : 'port ' + addr.port;

  console.log('✅ Quickcom Backend running on ' + bind);

  debug('Listening on ' + bind);
}